# Lokalne ustawienia narzędzi (per maszyna) - nie wersjonujemy
.claude/settings.local.json
.vscode/

# Systemowe
Thumbs.db
.DS_Store

# Staging budowania paczek (tools/build-packages.ps1)
.pkgtmp/

# Narzędzia dev (Vite + posthtml-include)
node_modules/

# Chunki CSS konfiguratora (generowane przez tools/gen-chunks.js w prebuild)
dist/chunks/

# Dane pakietu molique-jit (generowane przez tools/gen-jit-package-data.js -
# kopia utilities.json/class-index.json/chunkow komponentow, odtwarzalna w
# kazdej chwili z gen-chunks.js + gen-jit-utilities.js)
tools/jit/package/data/
tools/jit/package/dist/

# Zawartosc pakietu npm "molique" (generowana przez tools/build-npm-molique.mjs
# - kopia css/scss/js/img + tlumaczenie komentarzy na EN + LICENSE/NOTICE/
# safelist, odtwarzalna w kazdej chwili z korzenia repo). package.json i
# README.md w tym katalogu SA wersjonowane (pisane recznie).
npm/molique/css/
npm/molique/scss/
npm/molique/js/
npm/molique/img/
npm/molique/LICENSE
npm/molique/NOTICE
npm/molique/purgecss.safelist.cjs

# Paczki wydania ZIP (generowane przez tools/build-packages.ps1) - binarki
# ida do GitHub Releases, nie do historii gita. package-sizes.json ZOSTAJE
# wersjonowany (czyta go vite.config.js przy KAZDYM buildzie strony, nie
# tylko przy wydaniu paczek).
dist/*.zip

# Build strony WWW (generowany przez `npm run build`)
_site/

# Lokalne strony testowe (weryfikacja okiem, nie część projektu)
/test-*.html

# Tabele zmiennych CSS dla docs-variables.html
# (generowane przez tools/gen-variables-doc.js w predev/prebuild)
src/partials/variables-*.html
