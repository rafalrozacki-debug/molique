ï»¿<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Admina - molique Docs</title>

    <link rel="stylesheet" href="css/molique-style.css" />
    <link rel="stylesheet" href="css/molique-style-admin.css" />
    <link rel="stylesheet" href="css/molique-style-docs.css" />
  </head>
  <body>
    <div class="admin-layout">
      <!-- PASEK BOCZNY -->
      <aside class="admin-sidebar">
        <a
          href="index.html"
          class="text-8 fw-black text-white text-decoration-none d-block mb-4 admin-logo-compact"
        >
          molique<span class="text-primary">.</span>
        </a>

        <ul class="admin-nav">
          <div class="docs-nav-title">Wprowadzenie</div>
          <li><a href="docs.html" class="admin-nav-link">Getting Started</a></li>

          <div class="docs-nav-title">Layout & Podstawy</div>
          <li><a href="docs-layout.html" class="admin-nav-link">Grid & Layout</a></li>
          <li><a href="docs-sections.html" class="admin-nav-link">Sekcje, Hero & Timeline</a></li>
          <li><a href="docs-typography.html" class="admin-nav-link">Typografia & Kolory</a></li>

          <div class="docs-nav-title">Komponenty UI</div>
          <li><a href="docs-buttons.html" class="admin-nav-link">Przyciski & Badges</a></li>
          <li><a href="docs-cards.html" class="admin-nav-link">Karty & Tabele</a></li>
          <li>
            <a href="docs-interactive.html" class="admin-nav-link">Modale, Tabs & Akordeony</a>
          </li>
          <li>
            <a href="docs-components-extra.html" class="admin-nav-link">Karuzele & Lightbox</a>
          </li>

          <div class="docs-nav-title">Wykresy & Dane</div>
          <li>
            <a href="docs-charts.html" class="admin-nav-link">Wykresy (Data Viz)</a>
          </li>

          <div class="docs-nav-title">Formularze</div>
          <li><a href="docs-forms.html" class="admin-nav-link">Inputy & Walidacja</a></li>
          <li><a href="docs-select.html" class="admin-nav-link">Searchable Select & Switche</a></li>

          <div class="docs-nav-title">Efekty & Widgety</div>
          <li>
            <a href="docs-animations.html" class="admin-nav-link">Animacje & Mikrointerakcje</a>
          </li>
          <li>
            <a href="docs-widgets.html" class="admin-nav-link">Widgety (Speed Dial, Share)</a>
          </li>

          <div class="docs-nav-title">Moduły zaawansowane</div>
          <li><a href="docs-eshop.html" class="admin-nav-link">Sklep Internetowy</a></li>
          <li><a href="docs-blog.html" class="admin-nav-link">Blog & Artykuły</a></li>
          <li><a href="docs-admin.html" class="admin-nav-link is-active">Panel Admina (Dashboard)</a></li>
        </ul>
      </aside>

      <!-- GŁÓWNA TREŚĆ -->
      <main class="admin-main">
        <div class="docs-content-wrapper">
          <div class="mb-5 pb-4 border-bottom">
            <h1 class="text-10 fw-black mb-3">Panel Admina (Dashboard)</h1>
            <p class="text-4 text-muted">
              Dedykowany moduł do budowy systemów CRM, ERP i paneli B2B. Wymaga załadowania pliku
              <code>molique-style-admin.css</code>.
            </p>
          </div>

          <!-- SEKCJA 1: LAYOUT -->
          <section class="mb-5 pb-5">
            <h2 class="text-6 fw-bold mb-4">1. Układ (Layout) i Bottom Nav</h2>
            <p class="text-muted mb-4">
              Moduł dostarcza klasę <code>.admin-layout</code>, która dzieli ekran na
              <code>.admin-sidebar</code> oraz <code>.admin-main</code>. Na urządzeniach mobilnych
              sidebar automatycznie zamienia się w wygodny pasek nawigacji na dole ekranu (Bottom
              Nav).
            </p>

            <div class="component-showcase">
              <div class="component-preview w-100 bg-surface">
                <div class="w-100 p-4 border rounded-2 bg-body text-center">
                  <p class="m-0 fw-bold">
                    Zmniejsz okno przeglądarki, aby zobaczyć transformację paska bocznego w Bottom
                    Nav!
                  </p>
                </div>
              </div>
              <div class="component-code">
                <button class="btn-copy">Kopiuj</button>
                <pre><code>&lt;!-- Podstawowa struktura panelu --&gt;
&lt;div class="admin-layout"&gt;
  
  &lt;aside class="admin-sidebar"&gt;
    &lt;!-- Użyj .admin-logo-compact aby zwinąć logo na mobile --&gt;
    &lt;a href="#" class="admin-logo-compact"&gt;Logo&lt;/a&gt;
    
    &lt;ul class="admin-nav"&gt;
      &lt;li&gt;&lt;a href="#" class="admin-nav-link is-active"&gt;Dashboard&lt;/a&gt;&lt;/li&gt;
      &lt;li&gt;&lt;a href="#" class="admin-nav-link"&gt;Klienci&lt;/a&gt;&lt;/li&gt;
    &lt;/ul&gt;
  &lt;/aside&gt;

  &lt;main class="admin-main"&gt;
    &lt;!-- Główna treść panelu --&gt;
  &lt;/main&gt;

&lt;/div&gt;</code></pre>
              </div>
            </div>
          </section>

          <!-- SEKCJA 2: STEPPER -->
          <section class="mb-5 pb-5">
            <h2 class="text-6 fw-bold mb-4">2. Stepper (Pasek postępu)</h2>
            <p class="text-muted mb-4">
              Idealny do wieloetapowych formularzy. Dostępny w dwóch wariantach: klasycznym (grube
              paski) oraz numerowanym (kółka połączone linią).
            </p>

            <div class="component-showcase">
              <div class="component-preview flex-column w-100 bg-surface gap-5">
                <!-- Wariant 1: Klasyczny -->
                <div class="w-100">
                  <p class="text-2 text-muted mb-3">Wariant klasyczny (Domyślny)</p>
                  <div class="stepper w-100">
                    <div class="step is-active">Krok 1: Wymiary</div>
                    <div class="step">Krok 2: Konstrukcja</div>
                    <div class="step">Krok 3: Dach</div>
                  </div>
                </div>

                <!-- Wariant 2: Numerowany -->
                <div class="w-100">
                  <p class="text-2 text-muted mb-3">Wariant numerowany (.stepper-numbered)</p>
                  <div class="stepper stepper-numbered w-100">
                    <div class="step is-completed">
                      <div class="step-line"></div>
                      Wymiary
                    </div>
                    <div class="step is-active">
                      <div class="step-line"></div>
                      Konstrukcja
                    </div>
                    <div class="step">
                      <div class="step-line"></div>
                      Dach
                    </div>
                    <div class="step">
                      <div class="step-line"></div>
                      Podsumowanie
                    </div>
                  </div>
                </div>
              </div>
              <div class="component-code">
                <button class="btn-copy">Kopiuj</button>
                <pre><code>&lt;div class="stepper"&gt;
  &lt;div class="step is-active"&gt;Krok 1: Wymiary&lt;/div&gt;
  &lt;div class="step"&gt;Krok 2: Konstrukcja&lt;/div&gt;
  &lt;div class="step"&gt;Krok 3: Dach&lt;/div&gt;
&lt;/div&gt;</code></pre>
              </div>

              <div class="component-code">
                <button class="btn-copy">Kopiuj</button>
                <pre><code>&lt;!-- Wariant Numerowany --&gt;
&lt;div class="stepper stepper-numbered"&gt;
  
  &lt;!-- Krok ukończony (is-completed koloruje linię) --&gt;
  &lt;div class="step is-completed"&gt;
    &lt;div class="step-line"&gt;&lt;/div&gt;
    Wymiary
  &lt;/div&gt;
  
  &lt;!-- Krok aktywny --&gt;
  &lt;div class="step is-active"&gt;
    &lt;div class="step-line"&gt;&lt;/div&gt;
    Konstrukcja
  &lt;/div&gt;
  
  &lt;!-- Krok przyszły --&gt;
  &lt;div class="step"&gt;
    &lt;div class="step-line"&gt;&lt;/div&gt;
    Dach
  &lt;/div&gt;
  
&lt;/div&gt;</code></pre>
              </div>
            </div>
          </section>

          <!-- SEKCJA 3: STATUS DOTS -->
          <section class="mb-5 pb-5">
            <h2 class="text-6 fw-bold mb-4">3. Kropki Statusu (Status Dots)</h2>
            <p class="text-muted mb-4">
              Lekki komponent do oznaczania stanu projektów lub leadów. Można połączyć go z klasą
              <code>.status-ping</code> z modułu animacji.
            </p>

            <div class="component-showcase">
              <div class="component-preview w-100 bg-surface gap-4">
                <span class="status-dot status-draft">Szkic</span>
                <span class="status-dot status-pending">Oczekuje</span>
                <span class="status-dot status-done">Zakończone</span>
                <span class="status-dot status-done status-ping">Live</span>
              </div>
              <div class="component-code">
                <button class="btn-copy">Kopiuj</button>
                <pre><code>&lt;span class="status-dot status-draft"&gt;Szkic&lt;/span&gt;
&lt;span class="status-dot status-pending"&gt;Oczekuje&lt;/span&gt;
&lt;span class="status-dot status-done"&gt;Zakończone&lt;/span&gt;

&lt;!-- Z pulsującą animacją --&gt;
&lt;span class="status-dot status-done status-ping"&gt;Live&lt;/span&gt;</code></pre>
              </div>
            </div>
          </section>

          <!-- Nawigacja dół -->
          <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
            <a href="docs-eshop.html" class="btn btn-secondary">➔ Wstecz: Sklep Internetowy</a>
            <div></div>
          </div>
        </div>
      </main>
    </div>

    <script src="js/molique-script.js"></script>
  </body>
</html>


